      "version": 1,
      "versionNonce": 161,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789730235498,
      "link": null,
      "locked": false,
      "text": "Foundry runtime / session logs are available; dedicated Application Insights wiring is not confirmed.\nDevelopment persistence needs only the Foundry project state feature, not an extra storage resource.\nSaved conversation memory survives restarts; accepted work and OAuth continuations may not.\nCaller-bound HMAC state holds intent, not delegated tokens or permissioned finance-result bodies.",
      "originalText": "Foundry runtime / session logs are available; dedicated Application Insights wiring is not confirmed.\nDevelopment persistence needs only the Foundry project state feature, not an extra storage resource.\nSaved conversation memory survives restarts; accepted work and OAuth continuations may not.\nCaller-bound HMAC state holds intent, not delegated tokens or permissioned finance-result bodies.",
      "fontSize": 19,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.35
    },
