    {
      "id": "dev-operations-text",
      "type": "text",
      "x": 116,
      "y": 1728,
      "width": 1055,
      "height": 190,
      "angle": 0,
      "strokeColor": "#000000",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.5,
