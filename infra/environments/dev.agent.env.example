# Hosted Agent configuration template, not an automatically loaded dotenv file.
# Resolve references with the approved deployment/secret mechanism; never commit rendered values.
# Do not declare FOUNDRY_* or AGENT_* variables: the hosted platform owns those namespaces.
ModelDeployment=gpt-4.1-mini
Orchestrator__SessionKeySalt=${ZAVA_DEV_SESSION_KEY_SALT}
Orchestrator__SessionTimeToLive=30.00:00:00
Orchestrator__SubagentTimeout=00:03:00
Orchestrator__MaxHistoryMessages=20
Orchestrator__LogSubagentText=false
Obo__ClientId=${ZAVA_DEV_BOT_APP_ID}
Obo__TenantId=${ZAVA_DEV_TENANT_ID}
Obo__Audience=${ZAVA_DEV_OBO_AUDIENCE}
Obo__ClientSecret=${ZAVA_DEV_BOT_CLIENT_SECRET}
Obo__UserTokenHeader=x-client-user-token
CopilotStudioAgent__EnvironmentId=${ZAVA_DEV_COPILOT_STUDIO_ENVIRONMENT_ID}
CopilotStudioAgent__SchemaName=${ZAVA_DEV_COPILOT_STUDIO_SCHEMA_NAME}
Fabric__SqlEndpoint=${ZAVA_DEV_FABRIC_SQL_ENDPOINT}
Fabric__Database=${ZAVA_DEV_FABRIC_DATABASE}
Fabric__WorkspaceId=${ZAVA_DEV_FABRIC_WORKSPACE_ID}
Fabric__DataAgentId=${ZAVA_DEV_FABRIC_DATA_AGENT_ID}
Fabric__SqlTimeout=00:00:20
Fabric__DataAgentTimeout=00:05:00
Resolver__SearchEndpoint=${ZAVA_DEV_SEARCH_ENDPOINT}
Resolver__SemanticConfigurationName=resolver-semantic
Resolver__EmbeddingEndpoint=${ZAVA_DEV_EMBEDDING_ENDPOINT}
# Index, catalogue version, embedding deployment and dimensions come from dbo.resolver_release.
Resolver__Timeout=00:00:20
Resolver__ClarificationTimeToLive=00:15:00
Resolver__MaxCandidates=8
