{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AgentApplication": {
    "StartTypingTimer": false,
    "RemoveRecipientMention": true,
    "NormalizeMentions": true,
    "UserAuthorization": {
      "AutoSignIn": true,
      "DefaultHandlerName": "mcs",
      "Handlers": {
        "mcs": {
          "Settings": {
            "AzureBotOAuthConnectionName": "mcs",
            "OBOConnectionName": "MCSConnection"
          }
        }
      }
    }
  },
  "ConnectionsMap": [
    {
      "ServiceUrl": "*",
      "Connection": "ServiceConnection"
    }
  ]
}
