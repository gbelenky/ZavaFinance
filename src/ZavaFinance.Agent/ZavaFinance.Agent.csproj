<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);OPENAI001</NoWarn>
    <RootNamespace>ZavaFinance.Agent</RootNamespace>
    <AssemblyName>ZavaFinance.Agent</AssemblyName>
    <UserSecretsId>b14a3738-069b-4e3d-b050-bc42dd84afe4</UserSecretsId>
  </PropertyGroup>

  <!--
    The routing agent, the three tools and the finance logic live in this project rather than in
    a separate library, because the hosted-agent code deploy uploads a single project directory:
    a project reference is silently dropped and the remote build fails on every shared type.

    The namespaces stay ZavaFinance.Core.* so the separation remains visible in the source tree,
    and ZavaFinance.Channel references this project to reuse exactly the same routing agent and
    tools. One copy of the code, one golden set, two hosts.
  -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ZavaFinance.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!--
    Azure.AI.AgentServer.Responses is the solution's only preview dependency, and it is confined
    to this project. It implements the hosted-agent runtime contract: port 8088, GET /readiness,
    POST /responses, SSE, graceful shutdown, and the x-client-* header forwarding this agent
    depends on.

    Its breaking changes across beta.2, beta.6 and beta.8 were all in resilient background
    execution, steerable conversations and stream providers. None of those APIs are used here:
    responses are returned whole, and conversation state is owned by this agent's own store. The
    handler surface this project consumes - ResponseHandler.CreateAsync, ResponseContext
    .ClientHeaders, GetInputTextAsync - has been stable since beta.1.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI" Version="1.21.0" />
    <PackageReference Include="Microsoft.Agents.AI.Foundry" Version="1.5.0" />
    <PackageReference Include="Microsoft.Agents.CopilotStudio.Client" Version="1.8.77" />
    <PackageReference Include="Microsoft.Agents.Storage" Version="1.8.77" />
    <PackageReference Include="Azure.AI.Projects" Version="2.0.1" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.4" />
    <PackageReference Include="Azure.AI.AgentServer.Responses" Version="1.0.0-beta.8" />
    <PackageReference Include="Azure.AI.Extensions.OpenAI" Version="2.0.0" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.89.0" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.22.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
    <PackageReference Include="Microsoft.OpenTelemetry" Version="1.0.7" />
  </ItemGroup>

</Project>
