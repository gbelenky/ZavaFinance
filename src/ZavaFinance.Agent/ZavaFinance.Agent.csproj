<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);OPENAI001</NoWarn>
    <RootNamespace>ZavaFinance.Agent</RootNamespace>
    <AssemblyName>ZavaFinance.Agent</AssemblyName>
    <UserSecretsId>b14a3738-069b-4e3d-b050-bc42dd84afe4</UserSecretsId>
    <DefaultItemExcludes>$(DefaultItemExcludes);Identity\bin\**;Identity\obj\**;Contracts\bin\**;Contracts\obj\**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- Keep the shared identity project within the single-directory hosted-agent upload. -->
  <ItemGroup>
    <Compile Remove="Identity\**\*.cs" />
    <ProjectReference Include="Identity\ZavaFinance.Identity.csproj" />
    <Compile Remove="Contracts\**\*.cs" />
    <ProjectReference Include="Contracts\ZavaFinance.Contracts.csproj" />
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ZavaFinance.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!--
    Foundry Hosted Agents is GA; this project's Responses hosting adapter remains prerelease.
    Responses is the only direct prerelease reference and also brings in prerelease Core.
    The adapter supplies HTTP/SSE hosting and x-client-* header forwarding; Core supplies the
    platform state-store integration. Review both packages for compatibility before upgrading.
    See docs/availability-and-support.md for the dated service, API and SDK distinctions.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI" Version="1.21.0" />
    <PackageReference Include="ModelContextProtocol.Core" Version="2.2.0" />
    <PackageReference Include="Microsoft.Agents.AI.Foundry" Version="1.5.0" />
    <PackageReference Include="Microsoft.Agents.CopilotStudio.Client" Version="1.8.77" />
    <PackageReference Include="Azure.AI.Projects" Version="2.0.1" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.4" />
    <PackageReference Include="Azure.AI.AgentServer.Responses" Version="1.0.0-beta.8" />
    <PackageReference Include="Azure.AI.Extensions.OpenAI" Version="2.0.0" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.89.0" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.22.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
    <PackageReference Include="Microsoft.OpenTelemetry" Version="1.0.7" />
  </ItemGroup>

</Project>
