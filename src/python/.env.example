# Configuration reference for authorized component development.
# Never commit the completed .env file or fabricate Foundry ingress variables.
# The hosted runtime supplies FOUNDRY_PROJECT_ENDPOINT itself.
AZURE_AI_PROJECT_ENDPOINT=https://rsc-fdr-swc.services.ai.azure.com/api/projects/prj-fdr-swc
ModelDeployment=gpt-5.4-mini
ModelReasoningEnabled=true
PYTHON_SESSION_KEY_SALT=
OBO_TENANT_ID=
OBO_CLIENT_ID=
OBO_AUDIENCE=
OBO_CLIENT_SECRET=
# Optional alternative requiring federation on the finance OAuth application.
OBO_MANAGED_IDENTITY_CLIENT_ID=
COPILOT_STUDIO_ENVIRONMENT_ID=
COPILOT_STUDIO_SCHEMA_NAME=
FABRIC_SQL_ENDPOINT=
FABRIC_DATABASE=
FABRIC_WORKSPACE_ID=
FABRIC_DATA_AGENT_ID=
RESOLVER_SEARCH_ENDPOINT=
RESOLVER_EMBEDDING_ENDPOINT=
RESOLVER_SEMANTIC_CONFIGURATION=resolver-semantic
PORT=8088
